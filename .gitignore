# Careful when editing: Git only reads `#` as a comment when it starts the
# line. Writing `data/   # what this is` turns the whole pattern into a literal
# string that matches nothing — that is how 492 MB of recordings and the
# database almost got into a commit. A comment always goes on its own line.

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── machine configuration ─────────────────────────────────────────────────
# `.env.example` stays versioned: it is what documents the variables.
.env

# ── everything the system produces while running ──────────────────────────
# Uploaded recordings, ROI crops, rendered clips, thumbnails, the disk queue
# and the database. Nothing here is source: `data/sample` comes from
# `tools/make_sample.py` and the rest appears by itself when using the system.
data/

# The database can land outside `data/` when someone points OW_DATA_DIR
# elsewhere; SQLite's WAL comes along.
*.db
*.db-shm
*.db-wal

# ── game assets ───────────────────────────────────────────────────────────
# Ultimate and kill icons are Overwatch material, cropped by whoever uses the
# system. The folders stay in the repository (empty) so the system finds the
# path — hence the exception for `.gitkeep`.
#
# `abilities/` is the same thing by another route: the official icons of every
# ability, downloaded by `tools/fetch_ability_icons.py`. That is 270 Blizzard
# images — game material, not this repository's source.
templates/kills/*
templates/ults/*
templates/abilities/*
!templates/**/.gitkeep

# ── editors ───────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
