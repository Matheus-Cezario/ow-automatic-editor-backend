# Copie para .env e ajuste. Todas as variaveis tem prefixo OW_.

# local  = fila em disco + storage em pasta + SQLite (nao precisa de nada rodando)
# docker = Redis Streams + MinIO + PostgreSQL
OW_MODE=local

OW_PROFILE=ow2_default
OW_LOG_LEVEL=INFO

# Onde ficam uploads, recortes intermediarios, clipes e a fila em disco
OW_DATA_DIR=./data

# Vazio = derivado do modo (SQLite no local, Postgres no docker)
OW_DATABASE_URL=

# Barramento (modo docker)
OW_REDIS_URL=redis://localhost:6379/0

# Storage S3 / MinIO (modo docker)
OW_S3_ENDPOINT=http://localhost:9000
OW_S3_BUCKET=ow-editor
OW_S3_ACCESS_KEY=minioadmin
OW_S3_SECRET_KEY=minioadmin

# Binarios externos, se nao estiverem no PATH
OW_FFMPEG=ffmpeg
OW_FFPROBE=ffprobe

# Quanto o editor espera por um detector que nunca respondeu antes de
# montar o video com os eventos que os outros acharam
OW_DETECTOR_TIMEOUT_S=900

# Memoria: teto de mensagens por stream do Redis (XACK nao apaga a entrada, e
# sem teto a RAM do Redis cresce com o numero de partidas ja processadas) e
# retencao da fila em disco no modo local.
OW_STREAM_MAXLEN=10000
OW_BUS_RETENTION_S=3600

# Conexoes por processo. O padrao serve a um worker de uma thread; o gateway
# atende varias requisicoes ao mesmo tempo e sobe estes numeros no compose.
OW_DB_POOL_SIZE=2
OW_DB_MAX_OVERFLOW=3
