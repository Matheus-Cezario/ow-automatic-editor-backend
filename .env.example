# Copy to .env and adjust. Every variable is prefixed OW_.

# local  = disk queue + folder storage + SQLite (needs nothing running)
# docker = Redis Streams + S3 + PostgreSQL
OW_MODE=local

OW_PROFILE=ow2_default
OW_LOG_LEVEL=INFO

# Where uploads, intermediate crops, clips and the disk queue live
OW_DATA_DIR=./data

# Empty = derived from the mode (SQLite in local, Postgres in docker)
OW_DATABASE_URL=

# Bus (docker mode)
OW_REDIS_URL=redis://localhost:6379/0

# S3 storage (docker mode)
OW_S3_ENDPOINT=http://localhost:9000
OW_S3_BUCKET=ow-editor
OW_S3_ACCESS_KEY=minioadmin
OW_S3_SECRET_KEY=minioadmin

# External binaries, if they are not on the PATH
OW_FFMPEG=ffmpeg
OW_FFPROBE=ffprobe

# How long the planner waits for a detector that never answered before
# closing the analysis with the events the others found
OW_DETECTOR_TIMEOUT_S=900

# Memory: cap on messages per Redis stream (XACK does not delete the entry, and
# without a cap Redis RAM grows with the number of matches already processed)
# and the disk queue's retention in local mode.
OW_STREAM_MAXLEN=10000
OW_BUS_RETENTION_S=3600

# Connections per process. The default suits a single-threaded worker; the
# gateway serves several requests at once and raises these in the compose.
OW_DB_POOL_SIZE=2
OW_DB_MAX_OVERFLOW=3
